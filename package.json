{
  "name": "portfolio",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:root-entry": "node scripts/prepare-root-entry.mjs",
    "predev": "npm run prepare:root-entry",
    "dev": "vite --port 5173 --host",
    "preview": "vite preview --port 5173 --host",
    "clean:build": "node scripts/clean-root-build.mjs",
    "prebuild": "npm run prepare:root-entry && npm run clean:build",
    "build": "vite build && node scripts/publish-root-build.mjs",
    "check:deploy": "node scripts/validate-root-build.mjs",
    "build:verify": "npm run build && npm run check:deploy",
    "deploy": "npm run build:verify"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "0.487.0",
    "motion": "12.23.24",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-icons": "^5.5.0",
    "react-router": "7.13.0",
    "tailwind-merge": "3.2.0",
    "tw-animate-css": "1.3.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.12",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "gh-pages": "^6.2.0",
    "tailwindcss": "4.1.12",
    "typescript": "^5.9.3",
    "vite": "6.4.1"
  }
}
